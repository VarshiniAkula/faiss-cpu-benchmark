# Regeneratable from scripts/make_data.py (seeded, deterministic).
data/xb.npy
data/xq.npy

# Local env.
.venv/
.venv_vtune/
__pycache__/
*.pyc

# Raw VTune captures (tens of MB each). Exported CSV/JSON in
# runs/*-vtune-*/ ARE committed; the raw per-run data directories are
# not. The .vtune "project" file at the top of each result-dir is kept.
runs/*-vtune-*/*/config/
runs/*-vtune-*/*/data.*/
runs/*-vtune-*/*/log/
runs/*-vtune-*/*/sqlite-db/
runs/*-vtune-*/*/.norun
runs/*-vtune-*/*/*.lock
